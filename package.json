{
  "name": "speakeasy",
  "version": "2.0.1",
  "description": "Chrome extension for AI-powered article summarization and text-to-speech",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:reading": "esbuild scripts/reading-test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=test-output/reading-test.mjs && node test-output/reading-test.mjs",
    "deploy": "npm run build && rsync -a --delete --exclude .git --exclude .gitignore --exclude .gitkeep --exclude .DS_Store dist/ \"$HOME/Desktop/SPEAKEASY/\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
